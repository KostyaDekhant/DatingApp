<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DatingAppClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="backgroundColor">@color/black</item>

        <item name="textColorContrast">@color/light_green</item>
        <item name="textColorFade">@color/light_gray</item>
        <item name="textColorMain">@color/white</item>
        <item name="textColorMainReverse">@color/black</item>
        <item name="cursorColor">@color/light_green</item>

        <item name="textSizeSmall">16sp</item>
        <item name="textSizeMedium">18sp</item>
        <item name="textSizeLarge">20sp</item>

        <item name="bubbleBackgroundColor">@color/white</item>
        <item name="bubbleTextColor">@color/black</item>

        <item name="bubbleProfileBackgroundColor">@color/light_green</item>
        <item name="bubbleProfileTextColor">@color/black</item>

        <item name="bubbleTextSize">16sp</item>

        <item name="indicatorActiveColor">@color/darkgray_transparent</item>
        <item name="indicatorColor">@color/darkgray_transparent</item>
        <item name="indicatorWidth">30dp</item>
        <item name="indicatorHeight">5dp</item>

        <item name="textEditHeight">55dp</item>
        <item name="buttonHeight">50dp</item>
    </style>

    <style name="Theme.DatingAppClient.Default" parent="Base.Theme.DatingAppClient"/>

    <style name="Theme.DatingAppClient.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.DatingAppClient.Default</item>
    </style>
</resources>