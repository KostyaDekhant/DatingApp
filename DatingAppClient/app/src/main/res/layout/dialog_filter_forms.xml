<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:dividerPadding="8dp">

        <!-- Возраст от -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAgeMin"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Возраст от"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAgeMin"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Возраст до -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAgeMax"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Возраст до"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAgeMax"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Рост от -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutHeightMin"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Рост от (см)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputHeightMin"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Рост до -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutHeightMax"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Рост до (см)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputHeightMax"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Пол -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пол"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/genderRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Мужской" />

            <RadioButton
                android:id="@+id/radioFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Женский" />

            <RadioButton
                android:id="@+id/radioBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Оба" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
