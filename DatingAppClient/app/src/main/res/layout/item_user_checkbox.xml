<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Аватар с обёрткой -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/avatarImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user"
                android:background="@drawable/bg_user_circle" />

            <!-- Круглая рамка (обводка) -->
            <View
                android:id="@+id/avatarBorder"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_user_check_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/checkmark"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="0dp"
                android:visibility="gone"
                android:src="@drawable/ic_check_circle_24"
                android:background="@drawable/bg_user_check_circle"
                 />
            <ImageView
                android:id="@+id/statusView"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:padding="2dp"
                android:layout_gravity="bottom|end"
                android:visibility="gone"
                android:src="@drawable/ic_online"
                android:background="@drawable/bg_user_check_circle"
                />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />
        </LinearLayout>

        <TextView
            android:id="@+id/ownerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Создатель"
            android:textSize="?attr/textSizeSmall"
            android:textColor="?attr/textColorContrast"
            android:visibility="gone"
            android:paddingHorizontal="5dp"
            android:paddingTop="5dp"
            android:layout_gravity="top"/>

    </LinearLayout>
</FrameLayout>