<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DatingAppClient" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/gray</item>
        <item name="backgroundColor">@color/white</item>

        <!-- Text colors -->
        <item name="textColorContrast">@color/green</item>
        <item name="textColorFade">@color/gray</item>
        <item name="textColorMain">@color/black</item>
        <item name="textColorMainReverse">@color/white</item>
        <item name="cursorColor">@color/green</item>

        <!-- Text size -->
        <item name="textSizeSmall">16sp</item>
        <item name="textSizeMedium">18sp</item>
        <item name="textSizeLarge">20sp</item>

        <!-- Bubble setting -->
        <item name="bubbleBackgroundColor">@color/black</item>
        <item name="bubbleTextColor">@color/white</item>

        <item name="bubbleProfileBackgroundColor">@color/green</item>
        <item name="bubbleProfileTextColor">@color/white</item>

        <item name="bubbleTextSize"> 16sp </item>

        <!-- -->
        <item name="textEditHeight">55dp</item>
        <item name="buttonHeight">50dp</item>
    </style>

    <style name="Theme.DatingAppClient.Default" parent="Base.Theme.DatingAppClient">

    </style>
</resources>